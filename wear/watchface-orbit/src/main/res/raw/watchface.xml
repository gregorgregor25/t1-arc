<?xml version="1.0" encoding="UTF-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:28:00"/>
    <Metadata key="STEP_GOAL" value="8000"/>

    <Scene backgroundColor="#FF000000">
        <ComplicationSlot x="0" y="0" width="450" height="450"
            scaleX="1.08" scaleY="1.08" pivotX="0.5" pivotY="0.5"
            slotId="3100" displayName="graph_slot_label" isCustomizable="FALSE"
            supportedTypes="PHOTO_IMAGE EMPTY">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <DefaultProviderPolicy
                primaryProvider="io.github.gregorgregor25.t1arc/io.github.gregorgregor25.t1arc.wear.complication.T1ArcOrbitGraphComplicationService"
                primaryProviderType="PHOTO_IMAGE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"/>
            <BoundingBox x="0" y="0" width="450" height="450" outlinePadding="1"/>
            <Complication type="PHOTO_IMAGE"><PartImage x="0" y="0" width="450" height="450"><Image resource="[COMPLICATION.PHOTO_IMAGE]"/></PartImage></Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <DigitalClock x="0" y="-13" width="450" height="115"
            scaleX="1.08" scaleY="1.08" pivotX="0.5" pivotY="0.5">
            <TimeText x="0" y="72" width="450" height="40" format="hh:mm"
                hourFormat="SYNC_TO_DEVICE" align="CENTER" alpha="255">
                <Font family="SYNC_TO_DEVICE" size="32" weight="MEDIUM" color="#FFFFFFFF"/>
            </TimeText>
        </DigitalClock>

        <ComplicationSlot x="65" y="135" width="320" height="158"
            scaleX="1.08" scaleY="1.08" pivotX="0.5" pivotY="0.5"
            slotId="300" displayName="glucose_slot_label" isCustomizable="FALSE"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY">
            <DefaultProviderPolicy
                primaryProvider="io.github.gregorgregor25.t1arc/io.github.gregorgregor25.t1arc.wear.complication.T1ArcOpticalGlucoseComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"/>
            <BoundingRoundBox x="0" y="0" width="320" height="158" cornerRadius="18" outlinePadding="2"/>
            <Complication type="RANGED_VALUE">
                <Group x="0" y="0" width="320" height="158" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Condition>
                        <Expressions>
                            <Expression name="rose"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] < 0.5]]></Expression>
                            <Expression name="amber"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 0.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 1.5]]></Expression>
                            <Expression name="orange"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 1.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 2.5]]></Expression>
                            <Expression name="cyan"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 2.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 3.5]]></Expression>
                            <Expression name="green"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 3.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 4.5]]></Expression>
                            <Expression name="blue"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 4.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 5.5]]></Expression>
                            <Expression name="purple"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 5.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 6.5]]></Expression>
                        </Expressions>
                        <Compare expression="rose"><PartText x="-10" y="8" width="320" height="98" tintColor="#FFFF9BAE"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="amber"><PartText x="-10" y="8" width="320" height="98" tintColor="#FFF1B66F"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="orange"><PartText x="-10" y="8" width="320" height="98" tintColor="#FFFFB066"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="cyan"><PartText x="-10" y="8" width="320" height="98" tintColor="#FF59D7E6"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="green"><PartText x="-10" y="8" width="320" height="98" tintColor="#FF69D5AC"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="blue"><PartText x="-10" y="8" width="320" height="98" tintColor="#FF82B7FF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="purple"><PartText x="-10" y="8" width="320" height="98" tintColor="#FFC2A9FF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Compare>
                        <Default><PartText x="-10" y="8" width="320" height="98" tintColor="#FFA9BDC2"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Default>
                    </Condition>
                    <Condition>
                        <Expressions>
                            <Expression name="rose"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] < 0.5]]></Expression>
                            <Expression name="amber"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 0.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 1.5]]></Expression>
                            <Expression name="orange"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 1.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 2.5]]></Expression>
                            <Expression name="cyan"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 2.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 3.5]]></Expression>
                            <Expression name="green"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 3.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 4.5]]></Expression>
                            <Expression name="blue"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 4.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 5.5]]></Expression>
                            <Expression name="purple"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 5.5 && [COMPLICATION.RANGED_VALUE_VALUE] < 6.5]]></Expression>
                        </Expressions>
                        <Compare expression="rose"><PartText x="224" y="12" width="64" height="60" tintColor="#FFFF9BAE"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="amber"><PartText x="224" y="12" width="64" height="60" tintColor="#FFF1B66F"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="orange"><PartText x="224" y="12" width="64" height="60" tintColor="#FFFFB066"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="cyan"><PartText x="224" y="12" width="64" height="60" tintColor="#FF59D7E6"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="green"><PartText x="224" y="12" width="64" height="60" tintColor="#FF69D5AC"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="blue"><PartText x="224" y="12" width="64" height="60" tintColor="#FF82B7FF"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Compare>
                        <Compare expression="purple"><PartText x="224" y="12" width="64" height="60" tintColor="#FFC2A9FF"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Compare>
                        <Default><PartText x="224" y="12" width="64" height="60" tintColor="#FFA9BDC2"><Text align="LEFT"><Font family="SYNC_TO_DEVICE" size="52" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Default>
                    </Condition>
                    <PartText x="0" y="103" width="320" height="24" tintColor="#FFF4F4F2"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="21">GLUCOSE</Font></Text></PartText>
                </Group>
                <Group x="0" y="0" width="320" height="158" alpha="0">
                    <Variant mode="AMBIENT" target="alpha" value="255"/>
                    <PartText x="0" y="5" width="320" height="104" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="98" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
                    <PartText x="0" y="114" width="320" height="22" tintColor="#FFC6D0D2"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18">GLUCOSE</Font></Text></PartText>
                </Group>
            </Complication>
            <Complication type="SHORT_TEXT"><PartText x="0" y="10" width="320" height="105" tintColor="#FFA9BDC2"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="98" weight="LIGHT"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
            <Complication type="EMPTY"><PartText x="0" y="10" width="320" height="105" tintColor="#FFA9BDC2"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="92" weight="LIGHT">--</Font></Text></PartText></Complication>
        </ComplicationSlot>

        <ComplicationSlot x="125" y="271" width="200" height="24"
            scaleX="1.08" scaleY="1.08" pivotX="0.5" pivotY="0.5"
            slotId="3200" displayName="freshness_slot_label" isCustomizable="FALSE"
            supportedTypes="SHORT_TEXT EMPTY">
            <DefaultProviderPolicy
                primaryProvider="io.github.gregorgregor25.t1arc/io.github.gregorgregor25.t1arc.wear.complication.T1ArcFreshnessComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"/>
            <BoundingBox x="0" y="0" width="200" height="24" outlinePadding="1"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="200" height="24" tintColor="#FFF4F4F2">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="200" height="24" tintColor="#FF9CAEB2"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM">MISSING</Font></Text></PartText>
            </Complication>
        </ComplicationSlot>

        <Group x="0" y="0" width="450" height="450" alpha="255" name="orbit_complications"
            scaleX="1.08" scaleY="1.08" pivotX="0.5" pivotY="0.5">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <PartDraw x="0" y="0" width="450" height="450">
                <Arc centerX="157" centerY="341" width="60" height="60" startAngle="0" endAngle="360"><Stroke thickness="1.5" color="#FF667174"/></Arc>
                <Arc centerX="227" centerY="341" width="60" height="60" startAngle="0" endAngle="360"><Stroke thickness="1.5" color="#FF667174"/></Arc>
                <Arc centerX="227" centerY="341" width="60" height="60" startAngle="0" endAngle="0"><Transform target="endAngle" value="[STEP_PERCENT] * 3.6"/><Stroke thickness="2.5" color="#FFF1B66F"/></Arc>
                <Arc centerX="300" centerY="341" width="60" height="60" startAngle="0" endAngle="360"><Stroke thickness="1.5" color="#FF667174"/></Arc>
                <Arc centerX="300" centerY="341" width="60" height="60" startAngle="0" endAngle="0"><Transform target="endAngle" value="[BATTERY_PERCENT] * 3.6"/><Stroke thickness="2.5" color="#FF59D7E6"/></Arc>
            </PartDraw>
            <PartImage x="145" y="312" width="24" height="24"><Image resource="orbit_calendar_icon"/></PartImage>
            <PartImage x="216" y="313" width="22" height="22"><Image resource="orbit_step_icon"/></PartImage>
            <PartImage x="288" y="312" width="24" height="24"><Image resource="orbit_battery_icon"/></PartImage>
            <Condition>
                <Expressions>
                    <Expression name="sun"><![CDATA[[DAY_OF_WEEK] == 1]]></Expression>
                    <Expression name="mon"><![CDATA[[DAY_OF_WEEK] == 2]]></Expression>
                    <Expression name="tue"><![CDATA[[DAY_OF_WEEK] == 3]]></Expression>
                    <Expression name="wed"><![CDATA[[DAY_OF_WEEK] == 4]]></Expression>
                    <Expression name="thu"><![CDATA[[DAY_OF_WEEK] == 5]]></Expression>
                    <Expression name="fri"><![CDATA[[DAY_OF_WEEK] == 6]]></Expression>
                    <Expression name="sat"><![CDATA[[DAY_OF_WEEK] == 7]]></Expression>
                </Expressions>
                <Compare expression="sun"><PartText x="127" y="337" width="60" height="14" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="10" weight="MEDIUM">SUN</Font></Text></PartText></Compare>
                <Compare expression="mon"><PartText x="127" y="337" width="60" height="14" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="10" weight="MEDIUM">MON</Font></Text></PartText></Compare>
                <Compare expression="tue"><PartText x="127" y="337" width="60" height="14" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="10" weight="MEDIUM">TUE</Font></Text></PartText></Compare>
                <Compare expression="wed"><PartText x="127" y="337" width="60" height="14" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="10" weight="MEDIUM">WED</Font></Text></PartText></Compare>
                <Compare expression="thu"><PartText x="127" y="337" width="60" height="14" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="10" weight="MEDIUM">THU</Font></Text></PartText></Compare>
                <Compare expression="fri"><PartText x="127" y="337" width="60" height="14" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="10" weight="MEDIUM">FRI</Font></Text></PartText></Compare>
                <Compare expression="sat"><PartText x="127" y="337" width="60" height="14" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="10" weight="MEDIUM">SAT</Font></Text></PartText></Compare>
            </Condition>
            <PartText x="127" y="349" width="60" height="20" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM"><Template>%s<Parameter expression="[DAY_Z]"/></Template></Font></Text></PartText>
            <PartText x="197" y="339" width="60" height="22" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15"><Template>%s<Parameter expression="numberFormat(&quot;#,###&quot;, [STEP_COUNT])"/></Template></Font></Text></PartText>
            <Condition>
                <Expressions>
                    <Expression name="battery_full"><![CDATA[[BATTERY_PERCENT] == 100]]></Expression>
                </Expressions>
                <Compare expression="battery_full">
                    <PartText x="270" y="340" width="60" height="20" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="13"><Template>%d%%<Parameter expression="[BATTERY_PERCENT]"/></Template></Font></Text></PartText>
                </Compare>
                <Default>
                    <PartText x="270" y="339" width="60" height="22" tintColor="#FFFFFFFF"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15"><Template>%d%%<Parameter expression="[BATTERY_PERCENT]"/></Template></Font></Text></PartText>
                </Default>
            </Condition>
        </Group>
    </Scene>
</WatchFace>
