# Developer proof only. Never commit real values.
TARVIS_ENROLLMENT_BEARER_TOKEN=
TARVIS_ENROLLMENT_BIND_IP=127.0.0.1
TARVIS_ENROLLMENT_PORT=7314
TARVIS_ENROLLMENT_CA_CERT_FILE=/run/tarvis-enrollment-secrets/ca-certificate.pem
TARVIS_ENROLLMENT_CA_KEY_FILE=/run/tarvis-enrollment-secrets/ca-private-key.pem
# Comma-separated SHA-256 fingerprints of explicitly reviewed Android
# attestation roots. The service refuses every enrolment when this is empty.
TARVIS_ALLOWED_ATTESTATION_ROOT_SHA256=
# This archived proof binds enrolment to the permanent T1 Arc package and an
# explicitly reviewed signing certificate. It is not an app runtime route.
TARVIS_ALLOWED_ANDROID_PACKAGES=io.github.gregorgregor25.t1arc
TARVIS_ALLOWED_ANDROID_SIGNING_CERT_SHA256=
TARVIS_ENROLLMENT_CHALLENGE_TTL_MS=120000
TARVIS_ENROLLMENT_CERTIFICATE_TTL_MS=300000
TARVIS_ENROLLMENT_MAX_CHALLENGES=1024
