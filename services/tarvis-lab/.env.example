# Developer proof only. Never commit real values.
OPENAI_MODEL=gpt-5.6-luna
# Luna and Terra are enabled by default. Add gpt-5.6-sol explicitly when a
# deeper, slower comparison run is wanted.
OPENAI_ALLOWED_MODELS=gpt-5.6-luna,gpt-5.6-terra

# Optional phone-hosted LFM2.5 test provider. The endpoint and secret are
# configured only on the private lab host; the browser never receives either value.
LFM_PHONE_CHAT_COMPLETIONS_URL=
LFM_PHONE_API_KEY_FILE=/run/tarvis-secrets/lfm-phone-api-key
LFM_PHONE_TIMEOUT_MS=360000

# Prefer a server-side key. To use a mounted secret instead, leave this blank and
# set OPENAI_API_KEY_FILE to the in-container path in a Compose override.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=

# Temporary migration aid: allows the developer app to send X-OpenAI-API-Key.
# Leave disabled for any shared or public deployment.
ALLOW_CLIENT_OPENAI_KEY=0

# Recommended whenever a TLS reverse proxy or tunnel exposes the service.
TARVIS_LAB_BEARER_TOKEN=

TARVIS_LAB_BIND_IP=127.0.0.1
TARVIS_LAB_PORT=7313
# Keep this on a RAM-backed filesystem such as /dev/shm on the lab host.
RAW_SQLITE_HOST_PATH=/dev/shm/t1arc-tarvis-raw.sqlite
RESULT_JOURNAL_HOST_DIR=/dev/shm/t1arc-tarvis-runs
# Persistent private directory, owned by the service user and mode 0700.
TARVIS_SECRET_HOST_DIR=/home/your-user/.config/t1arc/tarvis-lab-secrets
SESSION_TTL_MS=1800000
MAX_SNAPSHOT_BYTES=33554432
OPENAI_TIMEOUT_MS=180000
MAX_TOOL_ROUNDS=8
