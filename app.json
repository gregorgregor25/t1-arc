{
  "expo": {
    "name": "T1 Arc",
    "slug": "daymark",
    "version": "1.6.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "daymark",
    "userInterfaceStyle": "automatic",
    "description": "Private, evidence-first Type 1 diabetes health intelligence.",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.daymark.personal",
      "versionCode": 23,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A6173",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-main-activity-lint-workaround",
      "./plugins/with-optional-camera-hardware",
      "./plugins/with-daymark-shortcuts",
      "./plugins/with-t1arc-release-signing",
      "./plugins/with-xdrip-local-network",
      "./plugins/with-health-connect-android",
      "./plugins/with-daymark-wear",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow T1 Arc to scan food barcodes. Images are not saved.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F1F8FA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#071519"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
