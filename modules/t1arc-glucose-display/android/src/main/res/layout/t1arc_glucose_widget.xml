<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/t1arc_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/t1arc_widget_background" android:orientation="vertical" android:padding="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/t1arc_widget_heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="Now" android:textColor="#B7CDD2" android:textSize="16sp" />
    <TextView android:id="@+id/t1arc_widget_age" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="No data" android:textColor="#B7CDD2" android:textSize="11sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/t1arc_widget_reading_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/t1arc_widget_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:fontFamily="sans-serif" android:includeFontPadding="false" android:letterSpacing="-0.04" android:maxLines="1"
      android:text="—" android:textColor="#69D5AC" android:textSize="68sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
      <TextView android:id="@+id/t1arc_widget_trend" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif" android:includeFontPadding="false" android:textColor="#69D5AC" android:textSize="30sp" android:textStyle="bold" />
      <TextView android:id="@+id/t1arc_widget_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="mmol/L" android:textColor="#B7CDD2" android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/t1arc_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
    android:ellipsize="end" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="2"
    android:text="Open T1 Arc to connect glucose" android:textColor="#E6F1F3" android:textSize="13sp" />
  <TextView android:id="@+id/t1arc_widget_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
    android:background="@drawable/t1arc_widget_badge" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
    android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textColor="#69D5AC" android:textSize="11sp" android:visibility="gone" />
  <ImageView android:id="@+id/t1arc_widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:layout_marginTop="10dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:visibility="gone" />
  <TextView android:id="@+id/t1arc_widget_chart_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
    android:gravity="end" android:textColor="#8FABB2" android:textSize="10sp" android:visibility="gone" />
  <TextView android:id="@+id/t1arc_widget_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
    android:ellipsize="end" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1"
    android:text="T1 ARC" android:textColor="#8FABB2" android:textSize="10sp" />
</LinearLayout>
