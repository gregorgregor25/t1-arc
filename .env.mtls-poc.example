# Archived direct-mTLS proof of concept only. This route is disconnected from
# the T1 Arc app and is not part of the BYOK release architecture.
EXPO_PUBLIC_TARVIS_DIRECT_MTLS_POC_ENABLED=0

# Private research build only. The enrolment bearer is not an OpenAI API key,
# but it would still be a credential embedded in that private APK.
EXPO_PUBLIC_TARVIS_DIRECT_ENROLLMENT_URL=https://enrolment.example.invalid
EXPO_PUBLIC_TARVIS_DIRECT_ENROLLMENT_BEARER=replace-for-private-poc
EXPO_PUBLIC_TARVIS_DIRECT_OPENAI_IDENTITY_PROVIDER_ID=replace-after-openai-setup
EXPO_PUBLIC_TARVIS_DIRECT_OPENAI_SERVICE_ACCOUNT_ID=replace-after-openai-setup
EXPO_PUBLIC_TARVIS_DIRECT_MODEL=gpt-5.6-luna
EXPO_PUBLIC_TARVIS_DIRECT_REASONING_EFFORT=low
